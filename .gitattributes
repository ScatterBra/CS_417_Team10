# Normalize line endings
* text=auto

# Code
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.compute   text
*.json      text
*.md        text
*.txt       text
*.xml       text
*.uss       text
*.uxml      text

# Unity YAML (force-text serialization) - merge with UnityYAMLMerge if configured
*.unity          text merge=unityyamlmerge eol=lf linguist-generated
*.prefab         text merge=unityyamlmerge eol=lf linguist-generated
*.asset          text merge=unityyamlmerge eol=lf linguist-generated
*.mat            text merge=unityyamlmerge eol=lf linguist-generated
*.anim           text merge=unityyamlmerge eol=lf linguist-generated
*.controller     text merge=unityyamlmerge eol=lf linguist-generated
*.overrideController text merge=unityyamlmerge eol=lf linguist-generated
*.physicMaterial text merge=unityyamlmerge eol=lf linguist-generated
*.physicsMaterial2D text merge=unityyamlmerge eol=lf linguist-generated
*.playable       text merge=unityyamlmerge eol=lf linguist-generated
*.mask           text merge=unityyamlmerge eol=lf linguist-generated
*.brush          text merge=unityyamlmerge eol=lf linguist-generated
*.flare          text merge=unityyamlmerge eol=lf linguist-generated
*.fontsettings   text merge=unityyamlmerge eol=lf linguist-generated
*.guiskin        text merge=unityyamlmerge eol=lf linguist-generated
*.giparams       text merge=unityyamlmerge eol=lf linguist-generated
*.renderTexture  text merge=unityyamlmerge eol=lf linguist-generated
*.spriteatlas    text merge=unityyamlmerge eol=lf linguist-generated
*.terrainlayer   text merge=unityyamlmerge eol=lf linguist-generated
*.lighting       text merge=unityyamlmerge eol=lf linguist-generated
*.meta           text merge=unityyamlmerge eol=lf linguist-generated
*.inputactions   text eol=lf
*.wlt            text eol=lf

# Git LFS - images
